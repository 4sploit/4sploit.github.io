---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getPosts, getAllTags, type Post } from '@/lib/content';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import TagBadge from '@/components/blog/TagBadge.astro';
import Pagination from '@/components/ui/Pagination.astro';
import Icon from '@/components/ui/Icon.astro';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return paginate(posts, { pageSize: siteConfig.blog.postsPerPage });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<Post>;
}

const { page } = Astro.props;
const tags = (await getAllTags()).slice(0, 12);
---

<BaseLayout
  title="Blog"
  description={`Articles on software engineering, performance, and developer tooling by ${siteConfig.author.name}.`}
>
  <div class="container-page py-10 sm:py-14">
    <header>
      <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Blog</h1>
      <p class="mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
        Notes on software engineering, performance, and the tools I use to build things.
      </p>

      {
        siteConfig.features.search && (
          <button
            type="button"
            data-search-open
            class="mt-6 flex h-10 w-full max-w-sm cursor-pointer items-center gap-2.5 rounded-lg border border-border bg-card px-3.5 text-sm text-muted-foreground transition-colors hover:border-muted-foreground/40 hover:text-foreground"
          >
            <Icon name="search" size={15} />
            Search articles...
            <kbd class="ml-auto hidden sm:inline">Ctrl K</kbd>
          </button>
        )
      }

      {
        tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-1.5">
            {tags.map(({ tag, count }) => (
              <TagBadge tag={tag} count={count} size="md" />
            ))}
          </div>
        )
      }
    </header>

    <div class="mt-8 flex flex-col border-t border-border/60 pt-4">
      {page.data.map((post) => <ArticleCard post={post} />)}
    </div>

    <Pagination
      currentPage={page.currentPage}
      lastPage={page.lastPage}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
    />
  </div>
</BaseLayout>
